DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PostgreSQL is required for deployment. Omit only for local SQLite smoke tests.
# DATABASE_URL=postgresql://studia:local-only@localhost:5432/studia
POSTGRES_PASSWORD=replace-with-a-strong-database-password
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
# For the optional OpenAI provider: AI_PROVIDER=openai and AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
AI_INPUT_PRICE_PER_MILLION=0.30
AI_OUTPUT_PRICE_PER_MILLION=2.50
DEMO_PASSWORD=
